"bx_engine_i4_2.0": {
    "information":{
        "authors":"BeamNG",
        "name":"2.0L I4 Engine",
        "value":4980,
    },
    "slotType" : "bx_engine",
    "slots": [
        ["type", "default", "description"],
        ["bx_enginemounts","bx_enginemounts", "Engine Mounts", {"coreSlot":true}],
