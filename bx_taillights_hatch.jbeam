          {"beamSpring":301000,"beamDamp":20},
          {"beamDeform":1400,"beamStrength":231000},
          ["tl4r", "r6rr"],
          ["tl2r", "r6rr"],
          ["tl1r", "q5r"],
          ["tl1r", "tb2rr"],
          ["tl2r", "q11r"],
          ["tl4r", "r6"],
          //to bumper
