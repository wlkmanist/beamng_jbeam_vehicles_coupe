          //["tl4r", "t4"],
          //["tl3r", "t3"],
          //["tl3r", "t3r"],
          //["tl1r", "t3rr"],
          //["tl3r", "t3rr"],
          //["tl1r", "t3r"],
          //["tl3r", "t4"],
          {"optional":false},
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
