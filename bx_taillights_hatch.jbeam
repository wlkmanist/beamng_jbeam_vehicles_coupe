            "lightRange":8,
            "lightColor":{"r":255, "g":0, "b":0, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "flareName":"vehicleBrakeLightFlare",
            "cookieName":""
        },
        ["lowhighbeam", "SPOTLIGHT", "tl2r", "tl4r", "tl1r", {"x":-20, "y":0, "z":-20}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0,0,0,1, {"baseTranslation":{"x":0.7, "y":0.35, "z":0.01},"flareScale":0.04,"lightBrightness":0.03,"lightRange":8,"deformGroup":"taillight_R_break"}],
        //signals
        {
            "lightInnerAngle":0,
            "lightOuterAngle":120,
            "lightRange":8,
            "lightColor":{"r":255, "g":150, "b":0, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "flareName":"vehicleBrakeLightFlare",
        },
        ["signal_R", "SPOTLIGHT", "tl2r", "tl4r", "tl1r", {"x":-20, "y":0, "z":-10}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0,0,0,1, {"baseTranslation":{"x":0.2, "y":0.35, "z":0.0},"flareScale":0.04,"lightBrightness":0.04,"deformGroup":"taillight_R_break"}],
     ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--taillight--
         //right
         {"selfCollision":true},
         {"collision":true},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.2},
         {"group":"bx_taillight_R"},
         ["tl1r", -0.7317, 2.0447, 0.7964],
         ["tl2r", -0.7495, 2.0322, 0.6794],
         ["tl3r", -0.596, 2.1092, 0.7964, {"selfCollision":false}],
         ["tl4r", -0.5541, 2.1351, 0.6794],
         ["tl5r", -0.598, 1.9799, 0.7294],
         {"group":""},
    ],

    "beams": [
          ["id1:", "id2:"],
          //--taillight--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":301000,"beamDamp":20},
          {"beamDeform":7000,"beamStrength":42000},
          //taillight main shape
          {"deformGroup":"taillight_R_break", "deformationTriggerRatio":0.05},
          {"deformLimitExpansion":1.2},
          ["tl4r", "tl3r"],
          ["tl2r", "tl1r"],
          ["tl1r", "tl3r"],
          ["tl4r", "tl2r"],
          ["tl2r", "tl3r"],
          ["tl1r", "tl4r"],
          ["tl5r", "tl2r"],
          ["tl5r", "tl1r"],
          ["tl5r", "tl4r"],
          ["tl5r", "tl3r"],

          //attach
          {"deformLimitExpansion":""},
          {"beamDeform":2800,"beamStrength":14700},
          {"breakGroup":"taillight_R"},
          ["tl1r", "q6r"],
          ["tl3r", "q6r"],
          ["tl4r", "q6r"],
          ["tl1r", "q13r"],
          ["tl3r", "q13r"],
          ["tl4r", "q13r"],
          ["tl1r", "r7"],
          ["tl3r", "r7"],
          ["tl4r", "r7"],
          ["tl1r", "r7rr"],
          ["tl3r", "r7rr"],
          ["tl4r", "r7rr"],
          {"breakGroup":""},
          {"deformGroup":""},

          //taillight support beams
          {"beamType":"|SUPPORT", "beamLongBound":4},
          {"beamSpring":301000,"beamDamp":20},
          {"beamDeform":1400,"beamStrength":231000},
          ["tl4r", "r6rr"],
          ["tl2r", "r6rr"],
          ["tl1r", "q5r"],
          ["tl1r", "tb2rr"],
          ["tl2r", "q11r"],
          ["tl4r", "r6"],
          //to bumper
          {"optional":true},
          ["tl2r", "rb2rr"],
          ["tl4r", "rb2r"],
          ["tl2r", "rb2r"],
          ["tl4r", "rb2rr"],
          ["tl2r", "rb2rrr"],
