          ["he2r", "fb2rr"],
          ["he1r", "fb2r"],
          {"breakGroup":"headlight_R_supportBeams"},
          {"deformGroup":"", "deformationTriggerRatio":""},

          //headlight support beams
          {"beamType":"|SUPPORT", "beamLongBound":3},
          {"beamDeform":7100,"beamStrength":"FLT_MAX"},
          ["he2r", "fb2rr"],
          ["he2r", "fb2rrr"],
          ["he1r", "fb2r"],
