{
"bx_headlight_R_fixed": {
    "information":{
        "authors":"BeamNG",
        "name":"USDM Right Headlight",
        "value":150,
    },
    "slotType" : "bx_headlight_R_fixed",
    "slots": [
        ["type", "default", "description"],
        ["bx_headlight_lid_fixed_R","", "Right Headlight Shade"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"bx_glass", "deformMaterialDamaged":"bx_glass_dmg"},
         ["bx_headlightglass_R_fixed", ["bx_headlight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound4", "deformVolume":0.5}],
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"bx_lights", "deformMaterialDamaged":"bx_lights_dmg"},
         ["bx_headlight_R_fixed", ["bx_headlight_R"]],
         {"deformGroup":""},
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":120,
            "lightColor":{"r":255, "g":255, "b":160, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":true,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"art/special/BNG_light_cookie_headlight.dds"
            "texSize":512,
            "shadowSoftness":0.5,
        },
        ["lowhighbeam" , "SPOTLIGHT", "he4r", "he3r", "he2r", {"x":-30, "y":0, "z":-175}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1,
        {"baseTranslation":{"x":0.19, "y":0.53, "z":-0.0},"lightRange":50,"lightBrightness":0.4,"lightOuterAngle":85,"flareScale":0.07,"deformGroup":"headlightglass_R_break"}],
        ["highbeam", "SPOTLIGHT", "he4r", "he3r", "he2r", {"x":-25, "y":0, "z":-175}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1,
        {"baseTranslation":{"x":0.61, "y":0.53, "z":-0.0},"lightRange":80,"lightBrightness":0.6,"lightOuterAngle":95,"flareScale":0.09,"deformGroup":"headlightglass_R_break"}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--HEADLIGHT--
         {"selfCollision":true},
         {"collision":true},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.4},
         {"group":"bx_headlight_R"},
         ["he1r", -0.3471, -2.0303, 0.6703],
         ["he3r", -0.285, -2.0699, 0.597],
         ["he2r", -0.6541, -1.936, 0.6703],
         ["he4r", -0.6541, -1.9656, 0.597],
         ["he5r", -0.2946, -1.9265, 0.6214, {"selfCollision":false}],
         ["he6r", -0.6685, -1.8361, 0.6214, {"selfCollision":false}],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //--HEADLIGHT--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":301000,"beamDamp":20},
          {"beamDeform":12000,"beamStrength":60000},
          //headlight main shape
          {"deformLimitExpansion":1.2},
          {"deformGroup":"headlightglass_R_break", "deformationTriggerRatio":0.1},
          ["he1r","he2r"],
          ["he3r","he4r"],
          ["he1r","he3r"],
          ["he2r","he4r"],
          ["he1r","he4r"],
          ["he2r","he3r"],
          ["he1r","he5r"],
          ["he2r","he5r"],
          ["he3r","he5r"],
          ["he4r","he5r"],
          ["he6r", "he4r"],
          ["he6r", "he2r"],
          ["he6r", "he3r"],
          ["he6r", "he1r"],
          ["he6r", "he5r"],

          //attach
          {"deformLimitExpansion":""},
          {"beamDeform":6000,"beamStrength":26000},
          {"breakGroup":"headlight_R_a"},
          ["he1r", "f15r"],
          ["he1r", "f13rr"],
          ["he1r", "f15rr"],
          ["he2r", "f15rr"],
          ["he2r", "f15r"],
          ["he2r", "f19rr", {"optional":true}],
          ["he4r", "f19rr", {"optional":true}],
          ["he4r", "f15rr"],
          ["he4r", "f13rr"],
          ["he3r", "f13rr"],
          ["he3r", "f19rr", {"optional":true}],
          ["he3r", "f15r"],
          ["he6r", "f19rr", {"optional":true}],
          ["he6r", "f15rr"],
          ["he5r", "f15r"],
          ["he5r", "f13rr"],
          {"breakGroup":"headlight_R_b"},
          {"optional":true},
          ["he3r", "fb2r"],
          ["he3r", "fb1r"],
          ["he3r", "fb1rr"],
          ["he4r", "fb1rr"],
          ["he4r", "fb2rr"],
          ["he4r", "fb1r"],
          ["he2r", "fb2rr"],
          ["he1r", "fb2r"],
          {"breakGroup":""},
          {"deformGroup":""},

          //headlight support beams
          {"beamType":"|SUPPORT", "beamLongBound":5},
          {"beamDeform":7100,"beamStrength":"FLT_MAX"},
          ["he2r", "fb2rr"],
          ["he2r", "fb2rrr"],
          ["he1r", "fb2r"],
          ["he3r", "fb2"],
          ["he3r", "fb2r"],
          ["he4r", "fb2rr"],
          ["he4r", "fb2rrr"],
          ["he1r", "fgr1"],
          ["he3r", "fb1"],
          {"optional":false},

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //left headlight
            {"groundModel":"plastic"},
            {"group":"bx_headlight_R"},
            {"dragCoef":6},
            ["he3r", "he1r", "he4r"],
            ["he4r", "he1r", "he2r"],
            ["he2r", "he6r", "he4r"],
            ["he1r", "he3r", "he5r"],
            ["he1r", "he5r", "he2r"],
            ["he2r", "he5r", "he6r"],
            ["he5r", "he4r", "he6r"],
            ["he5r", "he3r", "he4r"],
    ],
