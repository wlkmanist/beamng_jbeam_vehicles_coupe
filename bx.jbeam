{
"bx": {
    "information":{
        "authors":"BeamNG",
        "name": {
            "txt":"ui.vehicleconfig.information.name.BRAND BRAND",
            "ctx":{
                "brand1":"ui.vehicleconfig.brand.Ibishu",
                "brand2":"ui.vehicleconfig.brand.BX-Series"
            }
        }
    },
    "slotType" : "main",
    "slots2": [
        ["name",                    "allowTypes",                "denyTypes", "default",       "description"],
        ["bx_body",                 ["bx_body"],                 [],          "bx_body_hatch", "Body",                    {"coreSlot":true}],
        ["paint_design",            ["paint_design"],            [],          "",              "Paint Design"],
        ["licenseplate_design_2_1", ["licenseplate_design_2_1"], [],          "",              "License Plate Design"],
        ["bx_mod",                  ["bx_mod"],                  [],          "",              "Additional Modification"]
    ],

    "scaledragCoef":0.84
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.2, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":20, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}],
        ["$headlightPitchComp", "range", "degree", "Headlights", 0, -3, 3, "Setup Specific Headlight Pitch Compensation", "Adjusts the headlight pitch  for this setup", {"minDis":-3, "maxDis":3}]
    ],
   "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["lowbeam_filament","electrics.lowbeam * electrics.electricalLoadCoef",0],
                ["highbeam_filament","electrics.highbeam * electrics.electricalLoadCoef",0],
                ["lowhighbeam_filament","electrics.lowhighbeam * electrics.electricalLoadCoef",0],
                ["lowhighSignal_L_filament","electrics.lowhighbeam_signal_L * electrics.electricalLoadCoef",0],
                ["lowhighSignal_R_filament","electrics.lowhighbeam_signal_R * electrics.electricalLoadCoef",0],
                ["signal_L_filament","electrics.signal_L * electrics.electricalLoadCoef",0],
                ["signal_R_filament","electrics.signal_R * electrics.electricalLoadCoef",0],
                ["brakelight_filament","electrics.brakelights * electrics.electricalLoadCoef",0],
                ["reverselight_filament","electrics.reverse * electrics.electricalLoadCoef",0],
                ["lowhighBrake_filament","(electrics.lowhighbeam * 0.25  + electrics.brakelights * 0.75 ) * electrics.electricalLoadCoef",0],
            ]
            "smoothers": [
                ["electricsName", "smootherType", "params"],
                ["lowbeam_filament","temporalNonLinear", [12,12]],
                ["highbeam_filament","temporalNonLinear", [10,10]],
                ["lowhighbeam_filament","temporalNonLinear", [12,12]],
                ["lowhighSignal_L_filament","temporalNonLinear", [15,15]],
                ["lowhighSignal_R_filament","temporalNonLinear", [15,15]],
                ["signal_L_filament","temporalNonLinear", [20,20]],
                ["signal_R_filament","temporalNonLinear", [20,20]],
                ["brakelight_filament","temporalNonLinear", [15,15]],
                ["reverselight_filament","temporalNonLinear", [10,10]],
                ["lowhighBrake_filament","temporalNonLinear", [15,15]],
            ]
        }
    }
    "glowMap":{
            "bx_signal_L":{"simpleFunction":{"signal_L_filament":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_signal_R":{"simpleFunction":{"signal_R_filament":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_brakelight":{"simpleFunction":{"lowhighBrake_filament":0.48}, "off":"bx_lights", "on":"bx_lights_on",      "materialEmissiveScaling":{"on_max":1}},
            "bx_taillight":{"simpleFunction":{"lowhighbeam_filament":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_chmsl":{"simpleFunction":{"brakelight_filament":1}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_headlight":{"simpleFunction":{"lowbeam_filament":0.49,"highbeam_filament":1}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_lowbeam":{"simpleFunction":{"lowbeam_filament":1}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_highbeam":{"simpleFunction":{"highbeam_filament":1}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_reverselight":{"simpleFunction":{"reverselight_filament":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_marker_L":{"simpleFunction":{"lowhighSignal_L_filament":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_marker_R":{"simpleFunction":{"lowhighSignal_R_filament":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_parkinglight":{"simpleFunction":{"lowhighbeam_filament":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on",       "materialEmissiveScaling":{"on_max":1}},
            //glass emissive
            "bx_signalglass_L":{"simpleFunction":{"signal_L_filament":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_signalglass_R":{"simpleFunction":{"signal_R_filament":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_brakelightglass":{"simpleFunction":{"lowhighBrake_filament":0.48}, "off":"bx_glass", "on":"bx_glass_on",       "materialEmissiveScaling":{"on_max":1}},
            "bx_taillightglass":{"simpleFunction":{"lowhighbeam_filament":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_chmslglass":{"simpleFunction":{"brakelight_filament":1}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_headlightglass":{"simpleFunction":{"lowbeam_filament":0.49,"highbeam_filament":1}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_reverselightglass":{"simpleFunction":{"reverselight_filament":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_parkinglightglass":{"simpleFunction":{"lowhighbeam_filament":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on",       "materialEmissiveScaling":{"on_max":1}},
            "bx_markerglass_L":{"simpleFunction":{"lowhighSignal_L_filament":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "bx_markerglass_R":{"simpleFunction":{"lowhighSignal_R_filament":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense",       "materialEmissiveScaling":{"on_max":1}},

            "bx_gauges":{"simpleFunction":{"lowhighbeam_filament":1}, "off":"bx_gauges", "on":"bx_gauges_on",       "materialEmissiveScaling":{"on_max":1}},

            //gauge lights
            "signal_L":{"simpleFunction":"signal_L", "off":"invis", "on":"decals_gauges"},
            "signal_R":{"simpleFunction":"signal_R", "off":"invis", "on":"decals_gauges"},
            "checkengine":{"simpleFunction":"checkengine", "off":"invis", "on":"decals_gauges"},
            "hazard":{"simpleFunction":"hazard", "off":"invis", "on":"decals_gauges"},
            "battery":{"simpleFunction":"battery", "off":"invis", "on":"decals_gauges"},
            "highbeam":{"simpleFunction":"highbeam", "off":"invis", "on":"decals_gauges"},
            "parkingbrake":{"simpleFunction":"parkingbrakelight", "off":"invis", "on":"decals_gauges"},
            "lowfuel":{"simpleFunction":"lowfuel", "off":"invis", "on":"decals_gauges"},
            "lowpressure":{"simpleFunction":"lowpressure", "off":"invis", "on":"invis"},
            "abs":{"simpleFunction":"abs", "off":"invis", "on":"decals_gauges"}
    }
},
