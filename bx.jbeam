{
"bx": {
    "information":{
        "authors":"BeamNG",
        "name":"Ibishu 200BX"
    },
    "slotType" : "main",
    "slots": [
        ["type", "default", "description"],
        ["bx_body","bx_body_hatch", "Body", {"coreSlot":true}],
        ["paint_design", "", "Paint Design"],
        ["licenseplate_design_2_1","","License Plate Design"],
        ["bx_mod", "", "Additional Modification"]
    ],

    "scaledragCoef":1.75
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}]
    ],
    "glowMap":{
            "bx_signal_L":{"simpleFunction":{"signal_L":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_signal_R":{"simpleFunction":{"signal_R":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_brakelight":{"simpleFunction":{"brake":0.49,"lowhighbeam":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_taillight":{"simpleFunction":{"lowhighbeam":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_chmsl":{"simpleFunction":{"brake":100}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_headlight":{"simpleFunction":{"lowbeam":0.49,"highbeam":1}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_lowbeam":{"simpleFunction":{"lowbeam":1}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_highbeam":{"simpleFunction":{"highbeam":1}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_reverselight":{"simpleFunction":{"reverse":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_marker_L":{"simpleFunction":{"lowhighbeam":0.49,"signal_L":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_marker_R":{"simpleFunction":{"lowhighbeam":0.49,"signal_R":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on_intense"},
            "bx_parkinglight":{"simpleFunction":{"lowhighbeam":0.49}, "off":"bx_lights", "on":"bx_lights_on", "on_intense":"bx_lights_on"},
            //glass emissive
            "bx_signalglass_L":{"simpleFunction":{"signal_L":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_signalglass_R":{"simpleFunction":{"signal_R":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_brakelightglass":{"simpleFunction":{"brake":0.49,"lowhighbeam":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_taillightglass":{"simpleFunction":{"lowhighbeam":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_chmslglass":{"simpleFunction":{"brake":100}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_headlightglass":{"simpleFunction":{"lowbeam":0.49,"highbeam":1}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_reverselightglass":{"simpleFunction":{"reverse":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_parkinglightglass":{"simpleFunction":{"lowhighbeam":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on"},
            "bx_markerglass_L":{"simpleFunction":{"lowhighbeam":0.49,"signal_L":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},
            "bx_markerglass_R":{"simpleFunction":{"lowhighbeam":0.49,"signal_R":0.49}, "off":"bx_glass", "on":"bx_glass_on", "on_intense":"bx_glass_on_intense"},

            "bx_gauges":{"simpleFunction":"lowhighbeam", "off":"bx_gauges", "on":"bx_gauges_on"},

            //gauge lights
            "signal_L":{"simpleFunction":"signal_L", "off":"invis", "on":"decals_gauges"},
            "signal_R":{"simpleFunction":"signal_R", "off":"invis", "on":"decals_gauges"},
            "checkengine":{"simpleFunction":"checkengine", "off":"invis", "on":"decals_gauges"},
            "hazard":{"simpleFunction":"hazard", "off":"invis", "on":"decals_gauges"},
            "battery":{"simpleFunction":"battery", "off":"invis", "on":"decals_gauges"},
            "highbeam":{"simpleFunction":"highbeam", "off":"invis", "on":"decals_gauges"},
            "parkingbrake":{"simpleFunction":"parkingbrakelight", "off":"invis", "on":"decals_gauges"},
            "lowfuel":{"simpleFunction":"lowfuel", "off":"invis", "on":"decals_gauges"},
            "lowpressure":{"simpleFunction":"lowpressure", "off":"invis", "on":"invis"},
            "abs":{"simpleFunction":"abs", "off":"invis", "on":"decals_gauges"}
    }
},
