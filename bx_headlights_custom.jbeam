{
"bx_headlight_R_popup_custom": {
    "information":{
        "authors":"BeamNG",
        "name":"USDM Right Custom Headlight",
        "value":300,
    },
    "slotType" : "bx_headlight_R_popup",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"bx_lights", "deformMaterialDamaged":"bx_lights"},
         ["bx_headlight_R_popup_fixed", ["bx_headlight_R"]],
         {"deformGroup":"headlightglass_L_break", "deformMaterialBase":"bx_glass", "deformMaterialDamaged":"bx_glass_dmg"},
         ["bx_headlightglass_R_popup_fixed", ["bx_headlight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound3", "deformVolume":0.5}],
         {"deformGroup":""},
    ],
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":120,
            "lightColor":{"r":255, "g":255, "b":210, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":true,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"art/special/BNG_light_cookie_headlight.dds",
            "texSize":512,
            "shadowSoftness":0.5
        },
        //low beams
        ["lowbeam", "SPOTLIGHT", "he2r", "he2rr", "he1r", {"x":-80, "y":-8, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.65, "y":0.45, "z":-0.015},"lightRange":50,"lightBrightness":0.4,"lightOuterAngle":75,"flareScale":0.07,"deformGroup":"headlightglass_R_break"}],
        //high beams
        ["highbeam", "SPOTLIGHT", "he2r", "he2rr", "he1r", {"x":-75, "y":-5, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.28, "y":0.45, "z":-0.015},"lightRange":80,"lightBrightness":0.7,"lightOuterAngle":90,"flareScale":0.08,"deformGroup":"headlightglass_R_break"}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--HEADLIGHTS--
         {"nodeWeight":0.4},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"selfCollision":true},
         {"collision":true},
         {"group":"bx_headlight_R"},
         ["he1rr", -0.66, -1.785, 0.74],
         ["he1r", -0.43, -1.83, 0.74],

         ["he2rr", -0.64, -1.95, 0.65],
         ["he2r", -0.41, -2.02, 0.65],

         {"selfCollision":false},
         ["he3rr", -0.63, -1.83, 0.63],
         ["he3r", -0.41, -1.89, 0.63],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //--HEADLIGHTS--
          {"beamType":"|NORMAL", "beamPrecompression":1, "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":401000,"beamDamp":20},
          {"beamDeform":31950,"beamStrength":"FLT_MAX"},
          //main shape
          {"deformLimitExpansion":1.1},
          {"deformationTriggerRatio":0.01},
          {"deformGroup":"headlightglass_R_break"},
          ["he1rr","he1r"],
          ["he2rr","he2r"],
          ["he3rr","he3r"],
          ["he1rr","he2rr"],
          ["he1r","he2r"],
          ["he1rr","he3rr"],
          ["he1r","he3r"],
          ["he2rr","he3rr"],
          ["he2r","he3r"],

          //cross
          {"deformLimitExpansion":""},
          ["he1rr","he2r"],
          ["he1rr","he3r"],
          ["he2rr","he1r"],
          ["he2rr","he3r"],
          ["he3rr","he1r"],
          ["he3rr","he2r"],

          //attach
          {"beamDeform":4750,"beamStrength":17500},
          {"breakGroup":"headlight_R"},
          ["he1rr","f15r"],
          ["he1rr","f15rr"],
          ["he1rr","f14rr"],
          ["he1r","f15r"],
          ["he1r","f15rr"],
          ["he1r","f14rr"],

          ["he1rr","f13rr"],
          ["he1rr","f19rr", {"optional":true}],
          ["he1r","f13rr"],
          ["he1r","f19rr", {"optional":true}],

          ["he2rr","f15r"],
          ["he2rr","f15rr"],
          ["he2rr","f14rr"],
          ["he2r","f15r"],
          ["he2r","f15rr"],
          ["he2r","f14rr"],

          ["he2rr","f13rr"],
          ["he2rr","f19rr", {"optional":true}],
          ["he2r","f13rr"],
          ["he2r","f19rr", {"optional":true}],
          {"deformGroup":""},
          {"breakGroup":""},

          //headlight support beams
          {"beamPrecompression":1,"beamType":"|SUPPORT","beamLongBound":4},
          {"optional":true},
          ["he1r","fb1r"],
          ["he1rr","fb1rr"],
          ["he1r","fb1"],
          {"optional":false},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //left headlight
            {"groundModel":"metal"},
            {"group":"bx_headlight_R"},
            {"dragCoef":4},
            ["he1r",  "he1rr", "he2rr"],
            ["he2r",  "he1r",  "he2rr"],
            ["he3r",  "he1r",  "he2r"],
            ["he3r",  "he2r",  "he3rr"],
            ["he2rr", "he3rr", "he2r"],
            ["he3rr", "he2rr", "he1rr"],
            {"group":""},
    ],
},
