    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //main shape
          {"beamSpring":250000,"beamDamp":25},
          {"beamDeform":35000,"beamStrength":160000},
          {"deformLimitExpansion":1.1},
          ["sp1rrr", "sp1rr"],
          ["sp1rr", "sp1r"],
          ["sp1r", "sp1"],
          ["sp1", "sp1l"],
          ["sp1l", "sp1ll"],
          ["sp1ll", "sp1lll"],
