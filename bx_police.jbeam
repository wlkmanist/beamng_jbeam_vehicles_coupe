"bx_antenna_trunk_hatch": {
    "information":{
        "authors":"BeamNG",
        "name":"Trunk Antenna",
        "value":180
    },
    "slotType" : "bx_trunk_accessory_hatch",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["hf_antenna", ["bx_trunk","bx_antenna_trunk"], [], {"pos":{"x":-0.0, "y":1.95, "z":0.94}, "rot":{"x":-9, "y":0, "z":0}, "scale":{"x":1.2, "y":1.2, "z":1.0}}],
    ],
    "trunkCoupler":{
        "$+openForceMagnitude":  5,
        "$+openForceDuration":   0,
        "$+closeForceMagnitude": 0,
        "$+closeForceDuration":  0,
    }
     "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"group":"bx_antenna_trunk"},
         {"selfCollision":true},
         {"collision":true},
         {"nodeWeight":0.14},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_RUBBER"},
         //base
         ["antb1r",-0.07, 2.0, 0.96],
         ["antb1l", 0.07, 2.0, 0.96],
         ["antb2", 0.0, 1.9, 0.98],
         //antenna
         ["ant1", 0.0, 1.95, 1.0],
         ["ant2", 0.0, 2.00, 1.25],
         ["ant3", 0.0, 2.04, 1.49]
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":35000,"beamDamp":50},
          {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
          //base
          ["antb1r","antb1l"],
          ["antb1r","antb2"],
          ["antb1l","antb2"],

          ["antb1r","ant1"],
          ["antb2","ant1"],
          ["antb1l","ant1"],
          //antenna
          ["ant1","ant2"],
          ["ant2","ant3"],

          {"beamSpring":5000,"beamDamp":10},
          ["antb1r","ant2"],
          ["antb2","ant2"],
          ["antb1l","ant2"],
          ["antb1r","ant3"],
          ["antb2","ant3"],
          ["antb1l","ant3"],
          //attach to trunk
          {"beamSpring":65000,"beamDamp":50},
          {"beamDeform":3200,"beamStrength":3200},
          {"breakGroup":"antenna_trunk"},
          ["antb1r","t3"],
          ["antb1l","t3"],
          ["antb1r","t2r"],
          ["antb1l","t2r"],
          ["antb1r","t2l"],
          ["antb1l","t2l"],
          ["antb2","t2r"],
          ["antb2","t2l"],
          ["antb1r","t5"],
          ["antb1l","t5"],
          ["antb2","t5"],
          ["ant1","t2l"],
          ["ant1","t2r"],
          ["ant1","t5"],
          {"breakGroup":""}
    ]
},
