"bx_flashers": {
    "information":{
        "authors":"BeamNG",
        "name":"Concealed Flashers",
        "value":200,
    },
    "slotType" : ["bx_roof_accessory_hatch", "bx_roof_accessory_coupe"],
    "slots2": [
        ["name",             "allowTypes",         "denyTypes", "default",               "description"],
        ["flasher_color",    ["flasher_color"],    [],          "flasher_color_bluered", "Flashers Color", {"coreSlot":true}],
        ["soundscape_siren", ["soundscape_siren"], [],          "soundscape_siren_5",    "Siren Audio"],
        ["flasher_bulb_FL",["us_lightbar_led_2_4W_x4"],[],"us_lightbar_led_2_4W_x4","Front Left Flasher LED Unit",{"coreSlot":true,"variables":{
          "$electric":"red_4", "$nodeRef":"rf1","$nodeX":"rf1l","$nodeY":"rf2","$deformGroup":"windshield_break","$posX": 0.405 ,"$posY":-0.09,"$posZ":1.2,"$rotX":0,"$rotY":0,"$rotZ":180,"$shadowEnable":0,"$disable":0
        }}],
        ["flasher_bulb_FR",["us_lightbar_led_1_4W_x4"],[],"us_lightbar_led_1_4W_x4","Front Right Flasher LED Unit",{"coreSlot":true,"variables":{
          "$electric":"blue_4","$nodeRef":"rf1","$nodeX":"rf1r","$nodeY":"rf2","$deformGroup":"windshield_break","$posX":-0.405, "$posY":-0.09,"$posZ":1.2,"$rotX":0,"$rotY":0,"$rotZ":180,"$shadowEnable":0,"$disable":0
        }}],
    ],
    "soundscape": [
        ["name", "src"],
        //affects siren location because siren soundscape part is loaded after
        {"node:":"f15r"}
    ],
    "controller": [
        ["fileName"],
        ["lightbar", {
          "defaultModeIndex": 1,
          "modes": [
              ["name", "config"],
              ["Chase", [
                  ["electric", "value", "duration"],
                    ["blue_4", 1, 0.2],
                    ["blue_4", 0, 0.1],
                    ["blue_4", 1, 0.05],
                    ["blue_4", 0, 0.1],
                    ["blue_4", 1, 0.05],
                    ["blue_4", 0, 0.2],

                    ["red_4", 0, 0.1],
                    ["red_4", 1, 0.1],
                    ["red_4", 0, 0.1],
                    ["red_4", 1, 0.3],
                  ],
              ],
          ]
        }]
    ],
    "glowMap":{
            "generic_flasher_led_L": {"simpleFunction":"blue_4", "off":"policeparts_lights_white", "on":"$=$components.lightbarMaterials.flasher1"},
            "generic_flasher_led_R": {"simpleFunction":"red_4",  "off":"policeparts_lights_white", "on":"$=$components.lightbarMaterials.flasher2"},
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        {"deformGroup":"windshield_break", "deformMaterialBase":"policeparts_lights_white", "deformMaterialDamaged":"policeparts_lights_white"},
        ["generic_flasher_led_L", ["bx_body"], [], {"pos":{"x":-0.47,  "y":-0.09, "z":1.20}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_L", ["bx_body"], [], {"pos":{"x":-0.405, "y":-0.09, "z":1.20}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_L", ["bx_body"], [], {"pos":{"x":-0.340, "y":-0.09, "z":1.20}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_R", ["bx_body"], [], {"pos":{"x": 0.47,  "y":-0.09, "z":1.20}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_R", ["bx_body"], [], {"pos":{"x": 0.405, "y":-0.09, "z":1.20}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}],
        ["generic_flasher_led_R", ["bx_body"], [], {"pos":{"x": 0.340, "y":-0.09, "z":1.20}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":0.5}}]
        {"deformGroup":""},
    ]
